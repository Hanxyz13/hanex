{
  "version": "1.15.0-alpha.15-reF1nd",
  "description": "sing-box reF1nd amd64v3 optimized Beta build",
  "homepage": "https://github.com/reF1nd/sing-box-releases",
  "license": "GPL-3.0-or-later",
  "architecture": {
    "64bit": {
      "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.15.0-alpha.15-reF1nd/sing-box-1.15.0-alpha.15-reF1nd-windows-amd64v3.zip",
      "hash": "04cf5f895ed149b0b82f4c742fa66541c6a1176678ca8469a0dd3b3bca9fb778"
    }
  },
  "pre_install": [
    "$nestedDir = Get-ChildItem -LiteralPath $dir -Directory | Where-Object { Test-Path (Join-Path $_.FullName 'sing-box.exe') } | Select-Object -First 1",
    "if ($nestedDir) {",
    "    foreach ($file in @('sing-box.exe', 'libcronet.dll')) {",
    "        $source = Join-Path $nestedDir.FullName $file",
    "        if (Test-Path $source) {",
    "            Move-Item -LiteralPath $source -Destination $dir -Force",
    "        }",
    "    }",
    "    Remove-Item -LiteralPath $nestedDir.FullName -Recurse -Force",
    "}"
  ],
  "bin": "sing-box.exe",
  "checkver": {
    "url": "https://api.github.com/repos/reF1nd/sing-box-releases/releases",
    "regex": "\"tag_name\"\\s*:\\s*\"v(\\d+\\.\\d+\\.\\d+-(?:alpha|beta)\\.\\d+-reF1nd)\""
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version/sing-box-$version-windows-amd64v3.zip"
      }
    }
  }
}
