  "pre_install": [
    "$nestedDir = Get-ChildItem -LiteralPath $dir -Directory | Where-Object { Test-Path (Join-Path $_.FullName 'sing-box.exe') } | Select-Object -First 1",
    "if ($nestedDir) {",
    "    foreach ($file in @('sing-box.exe', 'libcronet.dll')) {",
    "        $source = Join-Path $nestedDir.FullName $file",
    "        if (Test-Path $source) {",
    "            Move-Item -LiteralPath $source -Destination $dir -Force",
    "        }",
    "    }",
    "    Remove-Item -LiteralPath $nestedDir.FullName -Recurse -Force",
    "}"
  ],
  "bin": "sing-box.exe",
